# 이 파일을 복사해서 .env.local 로 저장하고 값을 채우세요.  (cp .env.example .env.local)
# .env.local 은 git 에 안 올라갑니다. 이 파일(.env.example)에는 진짜 주소를 넣지 마세요.
#
# 여기 넣은 링크는 내 컴퓨터의 개발 서버(npm run dev)에서만 대시보드에 뜨고,
# npm run build 결과물에는 들어가지 않습니다.

# 구글 스프레드시트 (자료 관리 시트) 주소
VITE_SHEET_URL=

# 사이트 관리자페이지 주소 (…/exec?page=admin&key=… 전체)
VITE_ADMIN_URL=
